# Copy to archive.env; generate independent secrets, e.g. openssl rand -hex 32.
ARCHIVE_ADMIN_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
ARCHIVE_READ_TOKEN=replace-with-a-different-random-secret-for-private-reading
ARCHIVE_ACCESS=private
ARCHIVE_COOKIE_SECURE=true
ARCHIVE_ALLOWED_ORIGINS=https://mydeimos.love
ARCHIVE_MAX_STORAGE_BYTES=21474836480
ARCHIVE_MAX_BYTES=2147483648
ARCHIVE_MAX_FILE_BYTES=1073741824
ARCHIVE_MAX_DATABASE_BYTES=33554432
ARCHIVE_MAX_FILES=20000
ARCHIVE_MAX_IMPORTS=2
ARCHIVE_STAGING_TTL_HOURS=24
