{
  "name": "mydei-character-site",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "lint": "eslint Mydei/src vite.config.ts vitest.config.ts playwright.config.ts tests scripts services",
    "typecheck": "tsc --noEmit",
    "check:content": "vitest run tests/content.test.ts --root .",
    "check:dist": "node scripts/verify-dist.mjs",
    "test": "vitest run --root .",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm check:content && pnpm test && pnpm test:archive && pnpm build && pnpm check:dist && pnpm test:e2e",
    "build": "vite build --config vite.config.ts --outDir ../dist --emptyOutDir",
    "archive:serve": "node services/tieba-archive-files/server.mjs",
    "test:archive": "node --test tests/archive-service.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "1.55.0",
    "@types/node": "^24.3.0",
    "@types/sql.js": "1.4.11",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  }
}
